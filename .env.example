# CSNP Member Portal - Environment Variables
# Copy this file to .env and fill in the values.

# Portal display name shown in the browser title and header
VITE_APP_TITLE=CSNP Member Portal

# Reference date used for date-sensitive features (e.g., enrollment periods, eligibility checks)
# Format: YYYY-MM-DD
VITE_REFERENCE_DATE=2024-06-11